<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/our_device_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="40dp"
        android:paddingVertical="10dp"
        android:background="#FF0000"
        android:textColor="@color/black"
        android:text="Bluetooth: Loading..."
        />
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_bluetooth_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="40dp"
        android:textOn="Server"
        android:textOff="Client"
        android:contentDescription="Switch bluetooth mode"
        android:text="Open/Discover" />

    <LinearLayout
        android:id="@+id/discover_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">
        <Button
            android:id="@+id/list_bluetooth_dev_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discover device"
            android:layout_marginHorizontal="40dp"
            android:textColor="#000000"
            android:backgroundTint="#F0F0F0"/>

        <Button
            android:id="@+id/list_bluetooth_app_dev_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discover App Device"
            android:layout_marginHorizontal="40dp"
            android:textColor="#000000"
            android:backgroundTint="#F0F0F0"/>
        <TableLayout
            android:id="@+id/discovered_device_table"
            android:layout_width="match_parent"
            android:layout_margin="20dp"
            android:stretchColumns="1"
            android:layout_gravity="end"
            android:layout_height="wrap_content">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:paddingHorizontal="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:background="#FF0000"
                    android:paddingVertical="10dp"
                    android:textColor="@color/black"
                    android:text="No device found"
                    android:hint="here"/>
            </TableRow>

        </TableLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/listener_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="visible">
        <Button
            android:id="@+id/open_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Connection"
            android:layout_margin="40dp"
            android:textColor="#000000"
            android:backgroundTint="#F0F0F0"/>
        <TextView
            android:id="@+id/connection_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:background="#FF0000"
            android:paddingVertical="10dp"
            android:layout_margin="40dp"
            android:textColor="@color/black"
            android:text="Status: Closed"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/after_connection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/connection_device_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:background="#FF0000"
            android:paddingVertical="10dp"
            android:layout_margin="40dp"
            android:textColor="@color/black"
            android:text="@string/device_display_here"/>

        <EditText
            android:layout_width="match_parent"
            android:id="@+id/send_message_text"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:textColor="@color/black"
            android:inputType="textMultiLine"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="20dp"
            app:layout_constraintWidth_percent="0.6"
            android:autofillHints="Type message here"
            tools:ignore="LabelFor">
        </EditText>
        <Button
            android:id="@+id/send_message_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="send message"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="8dp"
            android:textColor="#000000"
            android:backgroundTint="#F0F0F0"/>
        <TextView
            android:id="@+id/message_receive_display"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:background="#FF0000"
            android:paddingVertical="10dp"
            android:layout_marginHorizontal="40dp"
            android:textColor="@color/black"
            android:text="==no_message=="/>
        <Button
            android:id="@+id/disconnect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disconnect"
            android:layout_marginEnd="40dp"
            android:layout_marginStart="40dp"
            android:textColor="#000000"
            android:backgroundTint="#F0F0F0"/>
    </LinearLayout>



</LinearLayout>